<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- There is deliberately no PlatformTarget. It stamped the assembly's PE machine type as
         AMD64, which made the published tool refuse to load on arm64 even though all it does is
         search for a string in a file and overwrite it. The architecture now comes from the
         RuntimeIdentifier that the publishing pipeline passes explicitly. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
